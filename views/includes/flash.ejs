<!--55(I). For displaying flash "success" message-->
<body>
    <!--55(J). If there is a success variable && it contains at least one success message, then only "success" alert'll display at top of page-->
    <% if(success && success.length){ %>
        <div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">   <!--show success alert, then make it fade & atlast invisible(dismissible)-->
            <%= success %>     <!--comes from 'connect-flash middleware' inside 'app.js'-->
            
            <!--In success alert, cross sign btn to remove the alert displaying-->
            <button 
                type="button" 
                class="btn-close" 
                data-bs-dismiss="alert" 
                aria-label="close">
            </button>
        </div>
    <% } %>

    <!--55(K). If there is a error variable && it contains at least one error message, then only "error" alert'll display at top of page-->
    <% if(error && error.length){ %>
        <div class="alert alert-danger alert-dismissible fade show col-6 offset-3" role="alert">   <!--show danger alert, then make it fade & atlast invisible(dismissible)-->
            <%= error %>     <!--comes from 'connect-flash middleware' inside 'app.js'-->
            
            <!--In error alert, cross sign btn to remove the alert displaying-->
            <button 
                type="button" 
                class="btn-close" 
                data-bs-dismiss="alert" 
                aria-label="close">
            </button>
        </div>
    <% } %>

    <!--NOTE: All the functionalities of styling're taken from Bootstrap-->
</body>
</html>