<!--48(B). Navbar-->
<!--here, we'll copy-paste the code for website's navbar form 'Bootstrap'-> 'navbar' option-->

<style>
  /*search btn*/
  .search-btn{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }

  .search-btn:hover{
    background-color: #fe424d;
    color: #fff;
  }

  .search-btn i{
    display: inline;
    margin-right: 0.5rem;
  }

  .search-inp{
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-solid fa-compass-drafting"></i></a>     <!--(copy font awesome cdn link in boilerplate.ejs inside <head>)this icon taken from 'Font awesome'-> search 'compass'-->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings"><b>ExploreEase</b></a>
      </div>

      <!--Search bar-->
      <!-- <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search">
          <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations"/>
          <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
        </form>
      </div> -->
      
      <form class="d-flex ms-auto" action="/search" method="GET" role="search">
        <input class="form-control me-2 search-inp" type="search" 
          name="q" placeholder="Search destinations" required/>
        <button class="btn search-btn" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>Search
        </button>
      </form>

      <!--57(C). Add styling on 'SignUp, Login, Logout' routes (from 'user.js') at navbar-->
      <div class="navbar-nav ms-auto">    <!--'ms-auto'-> margin start, to move these 3 at right corner-->
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <!--if user login not exist(not logged in), then show signup, login option on navbar-->
        <% if(!currUser){ %>      <!--'currUser' is defined in 'res.locals.currUser = req.user;' in app.js, to use currUser here-->
        <a class="nav-link" href="/signup"><b>Sign Up</b></a>
        <a class="nav-link" href="/login"><b>Log In</b></a>
        <% } %>

        <!--otherwise, if login exists(already logged in), then only show Logout option in navbar-->
        <% if(currUser){ %>
        <a class="nav-link" href="/logout"><b>Log Out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>