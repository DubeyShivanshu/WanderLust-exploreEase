<!--48(A). Create Boilerplate(making this 'edit.ejs' page on server(localhost), layout'll be same as main layout file 'boilerplate.ejs' means navbar,header,footer etc same on every page)-->
<% layout("/layouts/boilerplate") %>

<body>

    <div class="row mt-3">      <!--this 'row' div to store this page in row form for outer styling(like width etc), mt-3 -> margin top to 3-->
      <div class="col-8 offset-2">
       <h3>Edit your Listing</h3>
       <br>
       <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">    <!--edit the specific list _id in /listings with method-override-> ?_method=PUT" & class="needs-validation" novalidate -> custom Bootstrap validation styles-->
        <div class="mb-3">                                                       <!--"mb-3" -> each div's margin below of 3 from other-->
            <label for="title" class="form-label">Title</label>                   <!--'form-label' : bootstrap class which Styles the <label> element in a form-->
            <input type="text" class="form-control" name="listing[title]" value="<%= listing.title %>" required>      <!--'form-control' : bootstrap class which Styles form input, textarea, or select field-->
          <div class="valid-feedback">Title looks good!</div>    <!--Bootstrap validation feedback success text msg(for title field)-->
        </div>

        <div class="mb-3">       
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" rows="3" cols="35"  required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a short description</div>    <!--Bootstrap validation feedback failure text msg(for description field)-->
        </div>    

        <!--59(B). Original image display on edit form-->
        <div class="mb-3">
            Original Listing Image <br>
            <img src="<%= originalImageUrl %>" />     <!--rendering from 'controllers/listing.js' from 'EDIT' Route (org listing img display)-->
        </div>

        <!--Upload New img btn option-->
        <div class="mb-3">
            <label for="image" class="form-label">Upload New Image</label>
            <input type="file" class="form-control" name="listing[image]">  
        </div>
      
        <div class="row">        <!--this 'row' class to make price & country field in same single line-->
            <div class="mb-3 col-md-4">   <!--col-md-4 : taking 4 cols space out of 12 cols, until the screen is >= medium(in bootstrap by def. 12 cols)-->
                <label for="price" class="form-label">Price</label>
                <input type="number" class="form-control" name="listing[price]" value="<%= listing.price %>" required>
              <div class="invalid-feedback">Price should be valid</div>    <!--Bootstrap validation feedback failure text msg(for price field)-->
            </div>
            <div class="mb-3 col-md-8">   <!--col-md-8 : taking rest of 8 cols space out of 12 cols, until the screen is >= medium(in bootstrap by def. 12 cols)-->
                <label for="country" class="form-label">Country</label>
                <label for="country" class="form-label">Country</label>
                <input type="text" class="form-control" name="listing[country]" value="<%= listing.country %>" required>
              <div class="invalid-feedback">Country name should be valid</div>    <!--Bootstrap validation feedback failure text msg(for country field)-->
            </div>
        </div>
        
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" class="form-control" name="listing[location]" value="<%= listing.location %>" required>
          <div class="invalid-feedback">Location should be valid</div>    <!--Bootstrap validation feedback failure text msg(for location field)-->
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select class="form-control" name="listing[category]" required>
            <option value="mountains" <%= listing.category === "mountains" ? "selected" : "" %>>Mountains</option>
            <option value="arctic" <%= listing.category === "arctic" ? "selected" : "" %>>Arctic</option>
            <option value="rooms" <%= listing.category === "rooms" ? "selected" : "" %>>Rooms</option>
            <option value="beach" <%= listing.category === "beach" ? "selected" : "" %>>Beach</option>
            <option value="deserts" <%= listing.category === "deserts" ? "selected" : "" %>>Deserts</option>
            <option value="iconic cities" <%= listing.category === "iconic cities" ? "selected" : "" %>>Iconic Cities</option>
            <option value="castles" <%= listing.category === "castles" ? "selected" : "" %>>Castles</option>
            <option value="amazing pools" <%= listing.category === "amazing pools" ? "selected" : "" %>>Amazing Pools</option>
            <option value="camping" <%= listing.category === "camping" ? "selected" : "" %>>Camping</option>
          </select>
        </div>

        <button class="btn btn-dark edit-btn mt-3">Edit</button>   <!--btn -> class name, btn-dark -> bootstrap btn functionality, edit-btn -> name for styling in style.css, mt-3 -> margin top to 3-->
        <br><br>
       </form>
      </div>
    </div>
    
    <script src="/js/script.js"></script>   <!--linking script.js file for bootstrap validation-->
</body>
</html>