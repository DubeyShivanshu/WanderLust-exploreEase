<!--47(G). Create(New & Create Route) for GET /listings/new rendered from index.js-->

<!--48(A). Create Boilerplate(making this 'new.ejs' page on server(localhost), layout'll be same as main layout file 'boilerplate.ejs' means navbar,header,footer etc same on every page)-->
<% layout("/layouts/boilerplate") %>

<body>
    <div class="row mt-3">               <!--this 'row' div to store this page in row form for outer styling(like width etc), mt-3 -> margin top to 3-->
      <div class="col-8 offset-2">         <!--(inside form styling)this 'col-8 offset-2' div for dividing each schema in 8 equal cols & offset-2 for moving the cols page with 2 towards right-->
        <!--form for create new list(place) & submit & redirect to main /listings page-->
        <h3>Create a New Listing</h3><br>
    
       <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">    <!--class="needs-validation" novalidate -> custom Bootstrap validation styles,enctype="multipart/form-data" -> used to upload files (images, videos, documents, etc.), installed 'multer' package, so that img get uploaded-->
        <div class="mb-3">                      <!--"mb-3" -> each div's margin below of 3 from other-->
            <label for="title" class="form-label">Title</label>      <!--'form-label' : bootstrap class which Styles the <label> element in a form-->
            <input class="form-control" type="text" name="listing[title]" placeholder="Add a cachy title" required>    <!--'form-control' : bootstrap class which Styles form input, textarea, or select field-->  
          <div class="valid-feedback">Title looks good!</div>    <!--Bootstrap validation feedback success text msg(for title field)-->
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" rows="3" cols="35" name="listing[description]" placeholder="Enter description" required></textarea>
          <div class="invalid-feedback">Please enter a short description</div>    <!--Bootstrap validation feedback failure text msg(for description field)-->
        </div>

        <div class="mb-3">
            <label for="image" class="form-label">Upload Listing Image</label>    <!--installed 'multer' package, so that img get uploaded-->
            <input type="file" name="listing[image]" class="form-control" required>   <!--type="file" -> user used to select and upload a file from their device-->
        </div>

        <div class="row">               <!--this 'row' class to make price & country field in same single line-->

            <div class="mb-3 col-md-4">    <!--col-md-4 : taking 4 cols space out of 12 cols, until the screen is >= medium(in bootstrap by def. 12 cols)-->
                <label for="price" class="form-label">Price</label>
                <input class="form-control" name="listing[price]" placeholder="1200" required>
              <div class="invalid-feedback">Price should be valid</div>    <!--Bootstrap validation feedback failure text msg(for price field)-->
            </div>
            <div class="mb-3 col-md-8">     <!--col-md-8 : taking rest of 8 cols space out of 12 cols, until the screen is >= medium(in bootstrap by def. 12 cols)-->
                <label for="country" class="form-label">Country</label>
                <input class="form-control" type="text" name="listing[country]" placeholder="India" required>
              <div class="invalid-feedback">Country name should be valid</div>    <!--Bootstrap validation feedback failure text msg(for country field)-->
            </div>

        </div>

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input class="form-control" type="text" name="listing[location]" placeholder="Uttar Pradesh" required>
          <div class="invalid-feedback">Location should be valid</div>    <!--Bootstrap validation feedback failure text msg(for location field)-->
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select class="form-control" name="listing[category]" required>
            <option value="">Select category</option>
            <option value="rooms">Rooms</option>
            <option value="iconic cities">Iconic Cities</option>
            <option value="mountains">Mountains</option>
            <option value="castles">Castles</option>
            <option value="amazing pools">Amazing Pools</option>
            <option value="camping">Camping</option>
            <option value="beach">Beach</option>
            <option value="deserts">Deserts</option>
            <option value="arctic">Arctic</option>
          </select>
          <div class="invalid-feedback">Please select category</div>
        </div>

        <button class="btn btn-danger add-btn mt-3">Add</button>   <!--btn -> class name, btn-dark -> btn functionality of bootstrap, add-btn -> name given for styling in style.css, mt-3 -> margin top to 3-->
        <br><br>
       </form>
      </div>
    </div>
    
</body>
</html>